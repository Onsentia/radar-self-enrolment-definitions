    "enrolment": {
        "eligibility": {
            "title": "Who Can Take Part",
            "description": "We can only accept people onto our study if they answer Yes to the following questions.",
            "items": [
                {
                    "fieldType": "yesno",
                    "id": "criteria1",
                    "description": "Are you over 16 years of age?"
                },
                {
                    "fieldType": "yesno",
                    "id": "criteria2",
                    "description": "Do you live in the United Kingdom?"
                }
            ]
        },
        "consent": {
            "title": "Consent",
            "description": "Before you can take part in this study, we need your consent to complete questionnaires about your sleep habits and (optionally) share data from your wearable devices or smartphone apps.",
            "requiredItems": [
                {
                    "fieldType": "yesno",
                    "id": "required1",
                    "description": "I confirm that I have read the attached information sheet for the Sleep Hygiene Study and have had the opportunity to consider the information and ask questions and had these answered satisfactorily."
                },
                {
                    "fieldType": "yesno",
                    "id": "required2",
                    "description": "I understand that my participation in the study is voluntary and that I am free to withdraw at any time without giving a reason and without detriment to myself."
                },
                {
                    "fieldType": "yesno",
                    "id": "required3",
                    "description": "I give permission for the study team to access and analyse my questionnaire responses about my sleep habits and related lifestyle factors."
                }
            ],
            "optionalItems": [
                {
                    "fieldType": "yesno",
                    "id": "optional1",
                    "description": "I give permission for the study team to access and collect data from my wearable devices or smartphone apps related to sleep, activity, and heart rate."
                },
                {
                    "fieldType": "yesno",
                    "id": "optional2",
                    "description": "I agree that the researchers may contact me in future about other research projects that I might be eligible for."
                }
            ],
            "signatureDescription": "By signing this consent form, I declare that I have provided accurate identity details (full name and electronic signature)."
        },
        "account": {
            "title": "Register Account",
            "description": "You need an account to give us your information and (optionally) connect your wearable or smartphone app."
        }
    },
